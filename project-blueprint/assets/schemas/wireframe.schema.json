{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ItzMeet2/project_blueprint_skill/project-blueprint/assets/schemas/wireframe.schema.json",
  "title": "Wireframe Spec",
  "description": "Input for render_wireframe.py. Screen ids are lowercase-kebab; state variants use the '<id>--empty' form. Row/column nesting depth (max 3) is enforced by the renderer, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "screens"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "viewport_presets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "integer",
            "minimum": 1
          }
        ],
        "items": false,
        "minItems": 2
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/element"
            }
          },
          "navigates_to": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "element",
                "screen"
              ],
              "properties": {
                "element": {
                  "type": "string",
                  "minLength": 1
                },
                "screen": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/header"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/input"
        },
        {
          "$ref": "#/$defs/textarea"
        },
        {
          "$ref": "#/$defs/select"
        },
        {
          "$ref": "#/$defs/checkbox"
        },
        {
          "$ref": "#/$defs/radio"
        },
        {
          "$ref": "#/$defs/toggle"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/card"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/tabs"
        },
        {
          "$ref": "#/$defs/nav"
        },
        {
          "$ref": "#/$defs/modal"
        },
        {
          "$ref": "#/$defs/divider"
        },
        {
          "$ref": "#/$defs/spacer"
        },
        {
          "$ref": "#/$defs/row"
        },
        {
          "$ref": "#/$defs/column"
        }
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "header"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "input"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        }
      }
    },
    "textarea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "textarea"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string"
        }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "select"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checkbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "checkbox"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "boolean"
        }
      }
    },
    "radio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "radio"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "const": "toggle"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "boolean"
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "button"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "link"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "card"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "columns"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tabs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "tabs"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "active": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nav": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "nav"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "active": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "modal"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "divider"
        }
      }
    },
    "spacer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "spacer"
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "type": {
          "const": "row"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children"
      ],
      "properties": {
        "type": {
          "const": "column"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    }
  }
}
